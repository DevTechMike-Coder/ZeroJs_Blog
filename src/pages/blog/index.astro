---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const otherPosts = posts.slice(1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Articles — ${SITE_TITLE}`}
			description={`Browse all technical articles, guides, and engineering notes on ${SITE_TITLE}.`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-header">
				<span class="tag-badge">Engineering Notebook</span>
				<h1 class="page-title">Articles & Writings</h1>
				<p class="page-subtitle">
					Deep dives into web performance, minimalist design systems, static-first engineering, and software longevity.
				</p>
			</section>

			{featuredPost && (
				<section class="featured-section">
					<article class="featured-card glass-card">
						<a href={`/blog/${featuredPost.id}/`} class="featured-link">
							{featuredPost.data.heroImage && (
								<div class="featured-image-wrap">
									<Image
										width={960}
										height={480}
										src={featuredPost.data.heroImage}
										alt={featuredPost.data.title}
										class="featured-image"
									/>
									<span class="featured-badge">Featured Post</span>
								</div>
							)}
							<div class="featured-content">
								<div class="post-meta">
									<FormattedDate date={featuredPost.data.pubDate} />
								</div>
								<h2 class="featured-title">{featuredPost.data.title}</h2>
								<p class="featured-desc">{featuredPost.data.description}</p>
								<span class="read-action">Read full article &rarr;</span>
							</div>
						</a>
					</article>
				</section>
			)}

			<section class="posts-grid-section">
				<h2 class="section-heading">More Articles</h2>
				<div class="posts-grid">
					{otherPosts.map((post) => (
						<article class="post-card glass-card">
							<a href={`/blog/${post.id}/`} class="post-card-link">
								{post.data.heroImage && (
									<div class="post-thumb-wrap">
										<Image
											width={600}
											height={320}
											src={post.data.heroImage}
											alt={post.data.title}
											class="post-thumb"
										/>
									</div>
								)}
								<div class="post-body">
									<div class="post-meta">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3 class="post-card-title">{post.data.title}</h3>
									<p class="post-card-desc">{post.data.description}</p>
									<span class="read-action-small">Read article &rarr;</span>
								</div>
							</a>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-header {
		text-align: center;
		padding: 2rem 0 3.5rem;
		max-width: 680px;
		margin: 0 auto;
	}

	.page-title {
		margin-top: 0.6rem;
		margin-bottom: 0.8rem;
	}

	.page-subtitle {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	/* Featured Card */
	.featured-section {
		margin-bottom: 4rem;
	}

	.featured-card {
		overflow: hidden;
	}

	.featured-link {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		text-decoration: none;
		align-items: center;
	}

	.featured-image-wrap {
		position: relative;
		height: 100%;
		min-height: 320px;
		overflow: hidden;
		background: var(--bg-surface);
	}

	.featured-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.featured-card:hover .featured-image {
		transform: scale(1.03);
	}

	.featured-badge {
		position: absolute;
		top: 1rem;
		left: 1rem;
		padding: 0.3rem 0.75rem;
		border-radius: var(--radius-pill);
		background: rgba(9, 13, 22, 0.85);
		backdrop-filter: blur(8px);
		border: 1px solid var(--border);
		color: var(--accent-light);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.featured-content {
		padding: 2.5rem;
		display: flex;
		flex-direction: column;
	}

	.post-meta {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 0.6rem;
	}

	.featured-title {
		font-size: 1.8rem;
		color: var(--text-primary);
		line-height: 1.3;
		margin-bottom: 0.8rem;
		transition: color 0.15s ease;
	}

	.featured-card:hover .featured-title {
		color: var(--accent-light);
	}

	.featured-desc {
		font-size: 1rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.read-action {
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--accent-cyan);
	}

	/* Posts Grid */
	.posts-grid-section {
		margin-bottom: 4rem;
	}

	.section-heading {
		font-size: 1.4rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.6rem;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.75rem;
	}

	.post-card {
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.post-card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
	}

	.post-thumb-wrap {
		width: 100%;
		height: 200px;
		overflow: hidden;
		background: var(--bg-surface);
	}

	.post-thumb {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.post-card:hover .post-thumb {
		transform: scale(1.04);
	}

	.post-body {
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.post-card-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		line-height: 1.35;
		margin-bottom: 0.6rem;
		transition: color 0.15s ease;
	}

	.post-card:hover .post-card-title {
		color: var(--accent-light);
	}

	.post-card-desc {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 1.25rem;
		flex: 1;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.read-action-small {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent-cyan);
	}

	@media (max-width: 800px) {
		.featured-link {
			grid-template-columns: 1fr;
		}
		.featured-image-wrap {
			min-height: 220px;
			max-height: 260px;
		}
		.featured-content {
			padding: 1.75rem;
		}
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.blog-header {
			padding: 1.25rem 0 2rem;
		}
		.page-title {
			font-size: 1.95rem;
		}
		.page-subtitle {
			font-size: 1rem;
		}
		.featured-section {
			margin-bottom: 2.75rem;
		}
		.featured-image-wrap {
			min-height: 180px;
			max-height: 220px;
		}
		.featured-content {
			padding: 1.25rem 1rem;
		}
		.featured-title {
			font-size: 1.4rem;
			line-height: 1.3;
		}
		.featured-desc {
			font-size: 0.95rem;
			margin-bottom: 1.2rem;
		}
		.post-thumb-wrap {
			height: 170px;
		}
		.post-body {
			padding: 1.25rem 1rem;
		}
		.post-card-title {
			font-size: 1.15rem;
		}
		.posts-grid {
			gap: 1.25rem;
		}
	}

	@media (max-width: 380px) {
		.featured-image-wrap,
		.post-thumb-wrap {
			height: 150px;
			min-height: 150px;
		}
	}
</style>
