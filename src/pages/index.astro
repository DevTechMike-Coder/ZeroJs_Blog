---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import LightningIcon from '../components/icons/LightningIcon.astro';
import LockIcon from '../components/icons/LockIcon.astro';
import SparklesIcon from '../components/icons/SparklesIcon.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} — Blazing Fast, Pure Performance`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero-section">
				<div class="hero-badge">
					<span class="status-dot"></span>
					<span>Zero Client JavaScript • 100% Static HTML</span>
				</div>
				<h1 class="hero-title">
					Speed, Craft, and the Power of <span class="gradient-text">Zero JavaScript</span>
				</h1>
				<p class="hero-description">
					A technical publication and digital journal dedicated to modern web performance, resilient software architecture, and the craft of lightweight web applications.
				</p>
				<div class="hero-actions">
					<a href="/blog" class="btn btn-primary" id="hero-explore-articles">
						<span>Explore Articles</span>
						<svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
							<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
						</svg>
					</a>
					<a href="/about" class="btn btn-secondary" id="hero-about-link">
						<span>The ZeroJS Philosophy</span>
					</a>
				</div>
			</section>

			<!-- Metrics / Highlights Grid -->
			<section class="metrics-grid">
				<div class="metric-card glass-card">
					<div class="metric-value">0 kB</div>
					<div class="metric-label">Client JS Overhead</div>
					<p class="metric-desc">Zero hydration penalties. Instant paint on any network or low-power device.</p>
				</div>
				<div class="metric-card glass-card">
					<div class="metric-value">100 / 100</div>
					<div class="metric-label">Lighthouse Scores</div>
					<p class="metric-desc">Perfect scores across Performance, Accessibility, Best Practices, and SEO.</p>
				</div>
				<div class="metric-card glass-card">
					<div class="metric-value">&lt; 30 ms</div>
					<div class="metric-label">First Contentful Paint</div>
					<p class="metric-desc">Ultra-lean static delivery over edge CDNs without layout shifts.</p>
				</div>
			</section>

			<!-- Featured Articles -->
			<section class="articles-section">
				<div class="section-header">
					<div>
						<span class="tag-badge">Recent Writings</span>
						<h2 class="section-title">Featured Articles</h2>
					</div>
					<a href="/blog" class="view-all-link">
						View all writings <span>&rarr;</span>
					</a>
				</div>

				<div class="articles-grid">
					{posts.map((post) => (
						<article class="article-card glass-card">
							<a href={`/blog/${post.id}/`} class="article-card-link">
								{post.data.heroImage && (
									<div class="article-thumb-wrap">
										<Image
											width={720}
											height={380}
											src={post.data.heroImage}
											alt={post.data.title}
											class="article-thumb"
										/>
									</div>
								)}
								<div class="article-content">
									<div class="article-meta">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3 class="article-title">{post.data.title}</h3>
									<p class="article-desc">{post.data.description}</p>
									<span class="read-more">Read article &rarr;</span>
								</div>
							</a>
						</article>
					))}
				</div>
			</section>

			<!-- Core Principles Section -->
			<section class="principles-section">
				<div class="principles-header">
					<span class="tag-badge">Guiding Philosophy</span>
					<h2 class="section-title">Built with Intention</h2>
					<p class="section-subtitle">
						The modern web has become laden with megabytes of JavaScript frameworks. ZeroJS is built on three fundamental tenets:
					</p>
				</div>

				<div class="principles-grid">
					<div class="principle-card glass-card">
						<div class="principle-icon">
							<LightningIcon size={26} />
						</div>
						<h3>Static-First Architecture</h3>
						<p>
							Content that doesn't need dynamic client-side state shouldn't demand client-side JavaScript execution. Pages render instantaneously and work reliably everywhere.
						</p>
					</div>
					<div class="principle-card glass-card">
						<div class="principle-icon">
							<LockIcon size={26} />
						</div>
						<h3>Privacy & Minimal Footprint</h3>
						<p>
							Respecting readers means eliminating surveillance trackers, invasive analytics scripts, and massive asset downloads that drain batteries and data caps.
						</p>
					</div>
					<div class="principle-card glass-card">
						<div class="principle-icon">
							<SparklesIcon size={26} />
						</div>
						<h3>Modern Craft & Aesthetics</h3>
						<p>
							Zero JavaScript doesn't mean boring or utilitarian. Through modern CSS, fluid layouts, and typographic discipline, we deliver stunning visual design effortlessly.
						</p>
					</div>
				</div>
			</section>

			<!-- RSS Feed CTA Card -->
			<section class="cta-banner glass-card">
				<div class="cta-content">
					<span class="tag-badge">Stay Connected</span>
					<h2>Subscribe via RSS</h2>
					<p>
						Receive every new essay directly in your favorite RSS reader. No email tracking, no algorithms, just pure open-web syndication.
					</p>
					<div class="cta-actions">
						<a href="/rss.xml" class="btn btn-primary" id="cta-rss-link">
							<svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
								<path d="M4 11a9 9 0 0 1 9 9"></path>
								<path d="M4 4a16 16 0 0 1 16 16"></path>
								<circle cx="5" cy="19" r="1"></circle>
							</svg>
							<span>Open RSS Feed</span>
						</a>
						<a href="https://github.com/DevTechMike-Coder/ZeroJs_Blog" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
							<span>Star on GitHub</span>
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Hero Section */
	.hero-section {
		padding: 3rem 0 4rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.9rem;
		border-radius: var(--radius-pill);
		background: rgba(99, 102, 241, 0.1);
		border: 1px solid rgba(99, 102, 241, 0.25);
		color: var(--accent-light);
		font-size: 0.82rem;
		font-weight: 600;
		margin-bottom: 1.5rem;
	}

	.hero-title {
		max-width: 820px;
		margin-bottom: 1.25rem;
	}

	.gradient-text {
		background: var(--gradient-brand);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-description {
		max-width: 650px;
		font-size: 1.2rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 2.2rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	/* Metrics Grid */
	.metrics-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin-bottom: 5rem;
	}

	.metric-card {
		padding: 1.75rem 1.5rem;
	}

	.metric-value {
		font-size: 2.2rem;
		font-weight: 800;
		color: var(--text-primary);
		line-height: 1.1;
		margin-bottom: 0.4rem;
		background: var(--gradient-brand);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.metric-label {
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--text-primary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.5rem;
	}

	.metric-desc {
		font-size: 0.9rem;
		color: var(--text-muted);
		margin: 0;
		line-height: 1.5;
	}

	/* Articles Section */
	.articles-section {
		margin-bottom: 5rem;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 2rem;
	}

	.section-title {
		margin-top: 0.4rem;
		margin-bottom: 0;
	}

	.view-all-link {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--accent-light);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.articles-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.article-card {
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.article-card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
	}

	.article-thumb-wrap {
		width: 100%;
		height: 180px;
		overflow: hidden;
		background: var(--bg-surface);
	}

	.article-thumb {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.article-card:hover .article-thumb {
		transform: scale(1.04);
	}

	.article-content {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.article-meta {
		font-size: 0.82rem;
		color: var(--text-muted);
		margin-bottom: 0.6rem;
	}

	.article-title {
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--text-primary);
		line-height: 1.35;
		margin-bottom: 0.6rem;
		transition: color 0.15s ease;
	}

	.article-card:hover .article-title {
		color: var(--accent-light);
	}

	.article-desc {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin-bottom: 1.25rem;
		flex: 1;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.read-more {
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--accent-cyan);
	}

	/* Principles Section */
	.principles-section {
		margin-bottom: 5rem;
	}

	.principles-header {
		text-align: center;
		max-width: 640px;
		margin: 0 auto 2.5rem;
	}

	.section-subtitle {
		font-size: 1.05rem;
		color: var(--text-secondary);
		margin-top: 0.6rem;
	}

	.principles-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.principle-card {
		padding: 2rem 1.75rem;
	}

	.principle-icon {
		font-size: 1.8rem;
		margin-bottom: 1rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: rgba(99, 102, 241, 0.12);
		border-radius: var(--radius-md);
	}

	.principle-card h3 {
		font-size: 1.25rem;
		margin-bottom: 0.75rem;
	}

	.principle-card p {
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	/* CTA Banner */
	.cta-banner {
		padding: 3.5rem 2rem;
		text-align: center;
		background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(6, 182, 212, 0.08) 100%), var(--bg-card);
		border: 1px solid rgba(99, 102, 241, 0.25);
	}

	.cta-content {
		max-width: 580px;
		margin: 0 auto;
	}

	.cta-content h2 {
		margin-top: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.cta-content p {
		color: var(--text-secondary);
		font-size: 1.05rem;
		line-height: 1.6;
		margin-bottom: 1.8rem;
	}

	.cta-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	@media (max-width: 900px) {
		.metrics-grid,
		.articles-grid,
		.principles-grid {
			grid-template-columns: 1fr;
		}
		.section-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
	}
</style>
