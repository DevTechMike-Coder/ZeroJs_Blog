---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import LightningIcon from './icons/LightningIcon.astro';
---

<header class="site-header">
	<nav class="header-nav">
		<div class="brand">
			<a href="/" class="brand-link" id="brand-logo-link">
				<span class="brand-icon">
					<LightningIcon size={20} />
				</span>
				<span class="brand-text">{SITE_TITLE}</span>
			</a>
			<span class="badge-zero">0 kB JS</span>
		</div>

		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<div class="nav-actions">
			<a href="/rss.xml" class="action-icon-link" aria-label="RSS Feed" title="RSS Feed">
				<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
			</a>
			<a href="https://github.com/DevTechMike-Coder/ZeroJs_Blog" target="_blank" rel="noopener noreferrer" class="action-icon-link" aria-label="GitHub Repository" title="GitHub">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
					<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		background: rgba(9, 13, 22, 0.82);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}

	.header-nav {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0.9rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.brand-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--text-primary);
	}

	.brand-icon {
		font-size: 1.25rem;
		line-height: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		background: rgba(99, 102, 241, 0.15);
		border: 1px solid rgba(99, 102, 241, 0.3);
		border-radius: var(--radius-sm);
	}

	.brand-text {
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		background: var(--gradient-brand);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.badge-zero {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-pill);
		background: rgba(16, 185, 129, 0.12);
		color: var(--accent-emerald);
		border: 1px solid rgba(16, 185, 129, 0.25);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		background: rgba(17, 23, 38, 0.6);
		padding: 0.3rem 0.4rem;
		border-radius: var(--radius-pill);
		border: 1px solid var(--border);
	}

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.action-icon-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: var(--radius-md);
		color: var(--text-secondary);
		border: 1px solid var(--border);
		background: var(--bg-card);
		transition: all 0.15s ease;
	}

	.action-icon-link:hover {
		color: var(--text-primary);
		border-color: var(--border-focus);
		background: var(--bg-surface-alt);
		transform: translateY(-1px);
	}

	@media (max-width: 640px) {
		.header-nav {
			padding: 0.75rem 1rem;
		}
		.brand {
			gap: 0.4rem;
		}
		.brand-icon {
			width: 28px;
			height: 28px;
		}
		.brand-text {
			font-size: 1.05rem;
		}
		.badge-zero {
			display: none;
		}
		.nav-actions {
			display: none;
		}
		.nav-links {
			padding: 0.2rem 0.25rem;
			gap: 0.15rem;
		}
	}

	@media (max-width: 380px) {
		.header-nav {
			padding: 0.65rem 0.75rem;
		}
		.brand-icon {
			width: 26px;
			height: 26px;
		}
		.brand-text {
			font-size: 0.95rem;
		}
	}
</style>
