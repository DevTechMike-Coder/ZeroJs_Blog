---
import { SITE_TITLE } from '../consts';
import LightningIcon from './icons/LightningIcon.astro';

const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-top">
			<div class="footer-brand">
				<a href="/" class="brand-link">
					<span class="brand-icon">
						<LightningIcon size={18} />
					</span>
					<span class="brand-text">{SITE_TITLE}</span>
				</a>
				<p class="brand-tagline">
					Statically compiled with Astro. Zero client-side JavaScript overhead. 100% performance by default.
				</p>
			</div>

			<div class="footer-links-group">
				<div class="footer-col">
					<h4>Navigation</h4>
					<ul>
						<li><a href="/">Home</a></li>
						<li><a href="/blog">Articles</a></li>
						<li><a href="/about">About</a></li>
						<li><a href="/rss.xml">RSS Feed</a></li>
					</ul>
				</div>
				<div class="footer-col">
					<h4>Connect</h4>
					<ul>
						<li><a href="https://github.com/DevTechMike-Coder/ZeroJs_Blog" target="_blank" rel="noopener noreferrer">GitHub</a></li>
						<li><a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro Docs</a></li>
						<li><a href="https://astro.build/chat" target="_blank" rel="noopener noreferrer">Community Discord</a></li>
					</ul>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p>&copy; {today.getFullYear()} {SITE_TITLE}. Built for speed, privacy, and simplicity.</p>
			<div class="status-indicator">
				<span class="status-dot"></span>
				<span>100% Clean HTML/CSS</span>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		background: #060911;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.92rem;
	}

	.footer-container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 4rem 1.5rem 2.5rem;
	}

	.footer-top {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 3rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--border);
	}

	.footer-brand {
		max-width: 380px;
	}

	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		margin-bottom: 0.8rem;
	}

	.brand-icon {
		font-size: 1.15rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		background: rgba(99, 102, 241, 0.15);
		border-radius: var(--radius-sm);
	}

	.brand-text {
		font-size: 1.2rem;
		font-weight: 800;
		background: var(--gradient-brand);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.brand-tagline {
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	.footer-links-group {
		display: flex;
		gap: 4rem;
	}

	.footer-col h4 {
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-primary);
		margin-bottom: 1rem;
	}

	.footer-col ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer-col a {
		color: var(--text-secondary);
		transition: color 0.15s ease;
	}

	.footer-col a:hover {
		color: var(--accent-light);
	}

	.footer-bottom {
		padding-top: 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.85rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	.status-indicator {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--text-secondary);
	}

	@media (max-width: 640px) {
		.footer-links-group {
			gap: 2.5rem;
		}
	}
</style>
