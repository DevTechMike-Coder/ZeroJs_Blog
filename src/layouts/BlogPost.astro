---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import LightningIcon from '../components/icons/LightningIcon.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} — ZeroJS`} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="post-main">
			<article class="post-article">
				<div class="post-nav">
					<a href="/blog" class="back-link">
						<svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
							<path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
						</svg>
						<span>Back to all articles</span>
					</a>
				</div>

				<header class="post-header">
					<div class="post-header-meta">
						<span class="meta-item">
							<FormattedDate date={pubDate} />
						</span>
						{updatedDate && (
							<span class="meta-item last-updated">
								(Updated <FormattedDate date={updatedDate} />)
							</span>
						)}
					</div>
					<h1 class="post-title">{title}</h1>
					{description && <p class="post-lead">{description}</p>}
				</header>

				{heroImage && (
					<div class="hero-image-container">
						<Image
							width={1020}
							height={510}
							src={heroImage}
							alt={title}
							class="hero-img"
						/>
					</div>
				)}

				<div class="prose">
					<slot />
				</div>

				<footer class="post-footer glass-card">
					<div class="author-box">
						<div class="author-avatar">
							<LightningIcon size={26} />
						</div>
						<div class="author-info">
							<h4>ZeroJS Journal</h4>
							<p>Dedicated to exploring high-performance web architecture, zero-bloat engineering, and modern standards.</p>
						</div>
					</div>
					<div class="post-footer-actions">
						<a href="/blog" class="btn btn-secondary">&larr; More Articles</a>
						<a href="/rss.xml" class="btn btn-primary">Subscribe RSS</a>
					</div>
				</footer>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-main {
		max-width: var(--container-max);
		padding-top: 2rem;
	}

	.post-article {
		max-width: 820px;
		margin: 0 auto;
	}

	.post-nav {
		margin-bottom: 2rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.92rem;
		font-weight: 600;
		color: var(--text-secondary);
		padding: 0.4rem 0.8rem;
		border-radius: var(--radius-pill);
		border: 1px solid var(--border);
		background: var(--bg-card);
		transition: all 0.15s ease;
	}

	.back-link:hover {
		color: var(--text-primary);
		border-color: var(--border-focus);
		transform: translateX(-2px);
	}

	.post-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.post-header-meta {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.9rem;
		color: var(--text-muted);
		margin-bottom: 1rem;
	}

	.last-updated {
		font-style: italic;
	}

	.post-title {
		font-size: clamp(2.2rem, 4.5vw, 3.2rem);
		line-height: 1.2;
		margin-bottom: 1rem;
		letter-spacing: -0.03em;
	}

	.post-lead {
		font-size: 1.2rem;
		color: var(--text-secondary);
		max-width: 680px;
		margin: 0 auto;
		line-height: 1.6;
	}

	.hero-image-container {
		width: 100%;
		border-radius: var(--radius-lg);
		overflow: hidden;
		margin-bottom: 3rem;
		border: 1px solid var(--border);
		box-shadow: var(--shadow-lg);
	}

	.hero-img {
		width: 100%;
		height: auto;
		display: block;
	}

	.post-footer {
		margin-top: 4rem;
		padding: 2.2rem;
		display: flex;
		flex-direction: column;
		gap: 1.8rem;
	}

	.author-box {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.author-avatar {
		font-size: 1.5rem;
		width: 52px;
		height: 52px;
		border-radius: var(--radius-md);
		background: rgba(99, 102, 241, 0.15);
		border: 1px solid rgba(99, 102, 241, 0.3);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.author-info h4 {
		margin: 0 0 0.3rem;
		font-size: 1.1rem;
	}

	.author-info p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--text-secondary);
		line-height: 1.5;
	}

	.post-footer-actions {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		border-top: 1px solid var(--border);
		padding-top: 1.5rem;
	}

	@media (max-width: 640px) {
		.post-main {
			padding-top: 1rem;
		}
		.post-nav {
			margin-bottom: 1.25rem;
		}
		.post-header {
			margin-bottom: 1.75rem;
		}
		.post-title {
			font-size: clamp(1.8rem, 6.5vw, 2.4rem);
			margin-bottom: 0.75rem;
		}
		.post-lead {
			font-size: 1.05rem;
		}
		.hero-image-container {
			margin-bottom: 1.75rem;
			border-radius: var(--radius-md);
		}
		.post-footer {
			margin-top: 2.75rem;
			padding: 1.5rem 1.1rem;
		}
		.author-box {
			flex-direction: column;
			text-align: center;
		}
		.author-avatar {
			width: 46px;
			height: 46px;
			margin: 0 auto;
		}
		.post-footer-actions {
			flex-direction: column;
			width: 100%;
			gap: 0.75rem;
		}
		.post-footer-actions .btn {
			width: 100%;
		}
	}
</style>
